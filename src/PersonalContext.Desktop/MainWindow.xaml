<Window x:Class="PersonalContext.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personal Context Home" Width="680" Height="420"
        MinWidth="440" MinHeight="320" Loaded="Window_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Personal Context Home" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Almacenamiento local" Margin="0,20,0,6" FontWeight="SemiBold" />
            <TextBlock x:Name="StatusText" Text="Abriendo la base local…" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="Ruta de la base" Margin="0,16,0,6" FontWeight="SemiBold" />
            <TextBox x:Name="DatabasePathText" IsReadOnly="True" TextWrapping="Wrap"
                     BorderThickness="0" Background="Transparent" Padding="0"
                     AutomationProperties.Name="Ruta de la base" />
            <TextBlock Text="Conversaciones guardadas" Margin="0,16,0,6" FontWeight="SemiBold" />
            <TextBlock x:Name="ConversationCountText" Text="Pendiente de lectura" FontSize="20" />
            <TextBlock x:Name="ErrorText" Margin="0,12,0,0" TextWrapping="Wrap"
                       Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
            <TextBlock Text="La captura de ChatGPT todavía no está conectada."
                       Margin="0,24,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>
